{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-out-of-scope.js",
            "timeout": 10,
            "statusMessage": "레포 범위 확인 중..."
          }
        ]
      }
    ]
  }
}
