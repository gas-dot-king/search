# Supabase 프로젝트 설정 → API 에서 복사
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 관리자 페이지 비밀번호 (원하는 값으로)
ADMIN_PASSWORD=change-me

# 네이버 클라우드 플랫폼 Maps > Application 의 Key ID (구 Client ID).
# 브라우저에 그대로 노출되는 값이라 비밀이 아니며, 보호는 콘솔의 "Web 서비스 URL"
# 도메인 등록으로 이루어집니다. 등록하지 않은 도메인에서는 인증 실패로 지도가 뜨지 않습니다.
NEXT_PUBLIC_NAVER_MAP_KEY_ID=

# true로 설정하면 Supabase 없이 화면·가입·빙고·로또 UI를 테스트합니다.
# 데모 데이터는 개발 서버를 재시작하면 초기화됩니다.
DEMO_MODE=false
